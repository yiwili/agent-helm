{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "tasks",
    "max_rework_rounds",
    "api_budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "goal": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "provider",
          "dependencies",
          "allowed_paths",
          "acceptance",
          "verifier_profile",
          "wall_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "goal": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "mock",
              "manual",
              "codex",
              "qoder-cn",
              "cursor",
              "claude",
              "deepseek",
              "antigravity"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "verifier_profile": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "wall_seconds": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 600
          },
          "mock_behavior": {
            "enum": [
              "good",
              "bad-first",
              "bad",
              "timeout",
              "quota",
              "permission"
            ]
          },
          "milestone_review": {
            "type": "boolean"
          }
        }
      }
    },
    "max_rework_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "api_budget": {
      "const": 0
    }
  }
}
