{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "candidate_hash",
    "reasons",
    "evidence_refs"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "rework",
        "escalate"
      ]
    },
    "candidate_hash": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "diff",
          "verification",
          "baseline",
          "scope"
        ]
      }
    }
  }
}
